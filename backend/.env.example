# Database
DATABASE_URL="postgresql://user:password@localhost:5432/accountabilibuddy"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"

# Google OAuth (same client ID used on frontend)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:noreply@accountabilibuddy.app"

# Mailgun (email invites)
MAILGUN_API_KEY="your-mailgun-api-key"
MAILGUN_DOMAIN="your-sandbox-or-custom-domain.mailgun.org"

# Frontend URL (for CORS and invite links)
FRONTEND_URL="https://your-frontend.railway.app"

# Public API URL (used to build photo URLs returned to clients)
NEXT_PUBLIC_API_URL="https://your-backend.railway.app"

# File uploads directory (use Railway volume mount path, e.g. /data/uploads)
UPLOADS_DIR="/data/uploads"
