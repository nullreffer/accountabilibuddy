# Backend API URL (Railway backend service URL)
VITE_API_URL=http://localhost:3001

# Google OAuth Client ID (same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# VAPID public key (same value as backend VAPID_PUBLIC_KEY)
# Generate with: cd backend && npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
